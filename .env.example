# SkillBridge AI Environment Variables

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database
DATABASE_URL=sqlite:///./skillbridge.db

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3 Key (Optional)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Demo Mode (Set to True if API keys are missing or for deterministic testing)
DEMO_MODE=True
