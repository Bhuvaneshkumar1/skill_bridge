# SkillBridge AI Environment Variables

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database Path (Leave blank to automatically use canonical project-root skillbridge.db)
DATABASE_URL=

# NVIDIA NIM API Key (Optional; set to enable live AI provider requests)
NVIDIA_API_KEY=your_nvidia_api_key_here

# YouTube Data API v3 Key (Optional)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Demo Mode (Set to True for deterministic offline testing without external API calls)
DEMO_MODE=True
